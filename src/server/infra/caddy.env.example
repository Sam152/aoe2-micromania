# Copy to /etc/caddy/caddy.env (chmod 600, owned by caddy) and fill in the token.
# ./install.sh does the copy on first run. systemd reads this file, so use plain
# KEY=value with no quoting or shell expansion.

# Cloudflare API token used for the ACME DNS-01 challenge. Create one at
# https://dash.cloudflare.com/profile/api-tokens with:
#   Zone / DNS / Edit   on ageofmicro.com
#   Zone / Zone / Read  on ageofmicro.com
CLOUDFLARE_API_TOKEN=replace-me

# Where the deno game server listens. Defaults to 127.0.0.1:3000 when unset, for
# the usual case of Caddy running on the same box as the server.
#MICROMANIA_UPSTREAM=127.0.0.1:3000

# Port Caddy serves HTTPS on. Must match the router's WAN 443 forward.
#CADDY_HTTPS_PORT=3001
